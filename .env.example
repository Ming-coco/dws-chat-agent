# Copy this file to .env. Never commit the populated .env file.
DWS_CHAT_AGENT_MODE=shadow
DWS_CHAT_AGENT_SELF_NAME=Your Name
DWS_CHAT_AGENT_SELF_OPEN_ID=your-open-dingtalk-id
DWS_CHAT_AGENT_CONTACTS_JSON=[{"alias":"teammate","display_name":"Teammate","user_id":"user-id","open_dingtalk_id":"open-dingtalk-id"}]
DWS_CHAT_AGENT_WORKSPACE_ROOT=/absolute/path/to/workspace
DWS_CHAT_AGENT_WORKTREE_ROOT=/absolute/path/to/workspace/.worktrees/dws-chat-agent
DWS_CHAT_AGENT_CODEX_BINARY=codex
DWS_CHAT_AGENT_DWS_PROFILE=null
# Pi 扩展白名单（JSON 数组）：留空 [] 表示加载全部已安装扩展；
# 指定路径时 pi 会加 --no-extensions，只加载列出的扩展。
DWS_CHAT_AGENT_PI_FRONT_EXTENSIONS_JSON=["/absolute/path/to/pi-mcp-adapter/index.ts"]
DWS_CHAT_AGENT_PI_WORKER_EXTENSIONS_JSON=["/absolute/path/to/superpowers/.pi/extensions/superpowers.ts"]

# issue 读取能力（内置 jira_issue 工具，见 src/dws_dm_agent/runners/jira_tools.py）。
# 不填也能启动，只是每次调用会明确报「未配置 JIRA_PAT」，而不是静默失败。
# JIRA_PAT 由部署方到 Jira「个人访问令牌」页面自行创建，只读权限即可；不要提交进仓库。
# 填在这里就生效，不需要另外设系统环境变量，也不需要为了换令牌重启服务。
JIRA_PAT=
# 可选，默认 https://issue.hsjdata.com
JIRA_BASE_URL=https://issue.hsjdata.com
# 可选，读取超时秒数，默认 30
JIRA_TIMEOUT_SECONDS=30

# GitLab 流水线查询能力（内置 gitlab_project / gitlab_pipeline，见
# src/dws_dm_agent/runners/gitlab_tools.py）。只读：看项目、保护分支、我的权限、
# 最近流水线，以及失败作业的日志尾部。不会触发、重试或取消流水线。
# 不填也能启动，只是每次调用会明确报「未配置 GITLAB_TOKEN」。
# 令牌到 GitLab 的「个人访问令牌」页面自行创建，勾 read_api 即可；不要提交进仓库。
# 与 JIRA_PAT 一样：填在这里立即生效，不用设系统环境变量，也不用重启服务。
GITLAB_TOKEN=
# 必填，你的 GitLab 地址（不带结尾斜杠）
GITLAB_BASE_URL=

# 浏览器验收能力（内置 browser_run，见 src/dws_dm_agent/runners/browser_tools.py）。
# 驱动本机已有的 Edge/Chrome/Chromium，走浏览器自带的 CDP，不需要装 Selenium
# 或 Playwright。全部留空即可，工具会自动找到系统里的浏览器。
# 只在自动探测失败时填（Windows 示例，注意用绝对路径）：
BROWSER_PATH=
# 可选，默认 1 开无头模式；调试时可设 0 让它弹出窗口
BROWSER_HEADLESS=1
