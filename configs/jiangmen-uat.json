{
  "name": "江门对公客户画像平台",
  "baseUrl": "${E2E_BASE_URL}",

  "browser": {
    "executablePath": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
    "headless": true,
    "viewport": { "width": 1600, "height": 1000 }
  },

  "login": {
    "url": "/login",
    "username": "${E2E_USER}",
    "password": "${E2E_PASS}",
    "successUrlNotContains": "/login"
  },

  "discover": {
    "mode": "auto",
    "maxDepth": 2,
    "excludeNames": ["展开", "收起", "折叠"]
  },

  "detect": {
    "consoleErrors": true,
    "pageErrors": true,
    "httpStatusMin": 400,
    "apiKeyword": "/api/",
    "minVisibleElements": 5,
    "minBodyText": 20,
    "pageTimeoutMs": 30000,
    "settleMs": 2500
  },

  "ignore": {
    "consolePatterns": [
      "favicon",
      "ResizeObserver loop",
      "hm.baidu.com",
      "Google Analytics"
    ],
    "apiPatterns": [
      "/pageFileExportRecord",
      "/getEntCollectionStatus",
      "/getMessageCount"
    ]
  },

  "logs": {
    "enabled": false,
    "via": "none",
    "containerMap": {}
  }
}
